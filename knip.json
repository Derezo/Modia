{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "api": {
      "entry": ["src/index.js"],
      "project": ["src/**/*.js"],
      "ignore": ["src/tests/**", "src/**/*.test.js"]
    },
    "frontend": {
      "entry": ["src/main.js", "vite.config.js"],
      "project": ["src/**/*.js"],
      "paths": {
        "@shared/*": ["../shared/*"]
      }
    },
    "admin": {
      "entry": ["src/main.jsx", "vite.config.js"],
      "project": ["src/**/*.{js,jsx}"],
      "ignore": ["src/tests/**"],
      "paths": {
        "@shared/*": ["../shared/*"]
      }
    },
    "shared": {
      "entry": ["*.js"],
      "project": ["*.js"]
    }
  },
  "ignore": ["**/node_modules/**", "scripts/**", "**/*.test.js"],
  "ignoreDependencies": ["sharp", "playwright", "@modia/shared"],
  "ignoreBinaries": ["pm2"]
}
