    "battle-maps:preview": "node scripts/battle-maps/render-v3-maps.mjs preview",
    "battle-maps:screenshot": "node scripts/battle-maps/render-v3-maps.mjs screenshot",
    "battle-maps:gallery": "node scripts/battle-maps/render-v3-maps.mjs gallery",
    "battle-maps:v3:preview": "node scripts/battle-maps/render-v3-maps.mjs preview",
    "battle-maps:v3:screenshot": "node scripts/battle-maps/render-v3-maps.mjs screenshot",
    "battle-maps:v3:gallery": "node scripts/battle-maps/render-v3-maps.mjs gallery",
    "battle-maps:v3:visual-test": "node --test scripts/battle-maps/render-v3-maps.test.mjs",
