    "battle-art:audit": "node scripts/battle-art/cli.mjs audit",
    "battle-art:preflight": "node scripts/battle-art/preflight.mjs",
    "battle-art:matrix": "node scripts/battle-art/cli.mjs matrix",
    "battle-art:scaffold": "node scripts/battle-art/cli.mjs scaffold",
    "battle-art:draft": "node scripts/battle-art/cli.mjs draft",
    "battle-art:generate": "node scripts/battle-art/cli.mjs generate",
    "battle-art:revalidate-failure": "node scripts/battle-art/cli.mjs revalidate-failure",
    "battle-art:normalize": "node scripts/battle-art/cli.mjs normalize",
    "battle-art:preview": "node scripts/battle-art/cli.mjs preview",
    "battle-art:review": "node scripts/battle-art/cli.mjs review",
    "battle-art:approve": "node scripts/battle-art/cli.mjs approve",
    "battle-art:revise": "node scripts/battle-art/cli.mjs revise",
    "battle-art:compile": "node scripts/battle-art/cli.mjs compile",
    "battle-art:archive": "node scripts/battle-art/cli.mjs archive",
    "battle-art:inventory": "node scripts/battle-art/cli.mjs inventory",
    "battle-art:check": "node scripts/battle-art/cli.mjs check && node --test scripts/battle-art/*.test.mjs",
    "battle-assets:inventory": "node scripts/battle-art/cli.mjs inventory",
