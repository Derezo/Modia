    "battle-maps:v3:contracts": "node --test shared/battleMap/versionRegistry.test.js shared/battleMap/V3Adapter.test.js shared/battleMap/BattleMapV3Resolver*.test.js shared/battleMap/BattleMapV3Selector.test.js shared/battleMap/v3/*.test.js",
    "battle-maps:templates:draft": "node scripts/battle-maps/draft-template.mjs",
    "battle-maps:templates:generate": "node scripts/battle-maps/generate-template-images.mjs",
    "battle-maps:templates:reject-candidate": "node scripts/battle-maps/reject-template-image-candidate.mjs",
