{
  "name": "modia",
  "version": "0.1.0",
  "private": true,
  "description": "Modia - Browser-based MMORPG",
  "workspaces": [
    "api",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "npm run dev -w api",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "db:migrate": "npm run migrate -w api",
    "db:seed": "npm run seed -w api",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:status": "bash scripts/db-status.sh",
    "db:fresh": "bash scripts/db-fresh.sh",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "generate:tiles": "node api/src/scripts/generate-tiles.js",
    "generate:obstacles": "node api/src/scripts/generate-obstacles.js",
    "generate:characters": "node api/src/scripts/generate-characters.js",
    "generate:enemies": "node api/src/scripts/generate-enemies.js",
    "generate:nodes": "node api/src/scripts/generate-nodes.js",
    "generate:backdrop": "node api/src/scripts/generate-world-backdrop.js",
    "generate:items": "node api/src/scripts/generate-items.js",
    "generate:portraits": "node api/src/scripts/generate-portraits.js",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:svg-icons": "node scripts/generate-svg-icons.js",
    "generate:svg-portraits": "node scripts/generate-svg-portraits.js",
    "generate:portrait-pngs": "node scripts/generate-icons.js --portraits",
    "generate:all": "node api/src/scripts/generate-all.js",
    "validate:sprites": "node api/src/scripts/validate-prompts.js",
    "validate:enemy": "node api/src/scripts/validate-prompts.js --type=enemy",
    "validate:character": "node api/src/scripts/validate-prompts.js --type=character",
    "doctor": "bash scripts/doctor.sh",
    "dev:setup": "bash scripts/dev-setup.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
