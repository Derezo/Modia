    "ai:generate:authored-player-candidates": "node scripts/ai-images/generate-authored-player-candidates.js",
    "ai:test:authored-player-candidates": "node --test scripts/ai-images/generate-authored-player-candidates.test.js",
    "ai:test:authored-player-animation-drafts": "node --test scripts/ai-images/draft-authored-player-animation.test.js",
