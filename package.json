    "ai:check:identity-references": "node scripts/ai-images/generate-player-identity-references.js --check",
    "ai:compile:player-identities": "node scripts/ai-images/compile-player-identity-fallbacks.js --all",
    "ai:check:player-identities": "node scripts/ai-images/compile-player-identity-fallbacks.js --all --check",
    "ai:test:player-identities": "node --test scripts/ai-images/compile-player-identity-fallbacks.test.js",
    "ai:sync:character-variants": "node scripts/ai-images/sync-player-character-variants.js",
    "ai:check:character-variants": "node scripts/ai-images/sync-player-character-variants.js --check",
