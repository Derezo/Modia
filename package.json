    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:load": "artillery run load-tests/config.yml",
    "dead-code": "knip",
    "dead-code:report": "knip --reporter json > knip-report.json || true",
