{
  "name": "modia",
  "version": "0.5.3",
  "private": true,
  "description": "Modia - Browser-based MMORPG",
  "workspaces": [
    "api",
    "frontend",
    "shared",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "npm run dev -w api",
    "dev:frontend": "npm run dev -w frontend",
    "dev:admin": "npm run dev -w admin",
    "dev:all": "concurrently -n api,web,admin -c blue,green,yellow \"npm run dev:api\" \"npm run dev:frontend\" \"npm run dev:admin\"",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run migrate -w api",
    "db:seed": "npm run seed -w api",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "world:migrate": "npm run world:migrate -w api --",
    "db:status": "bash scripts/db-status.sh",
    "db:fresh": "bash scripts/db-fresh.sh",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:shell": "bats tests/",
