# Dependencies
node_modules/

# Environment files
.env*
!.env.example

# Keys & certs
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx

# SSH keys
id_rsa
id_rsa.*
id_ed25519*
*.ppk

# Cloud / registry credentials
credentials
credentials.json
.npmrc
*-service-account*.json

# Database dumps
*.sql.dump
*.dump
dump.sql
*.sqlite
*.sqlite3

# Deployment config (contains infrastructure details; kept local / in lsd-vault)
deploy.yaml

# Build outputs
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# PM2
.pm2/

# File locks (cross-process synchronization)
.locks/

# Test coverage
coverage/

# Database
*.sql.backup

# Generated assets (AI-generated images, audio, sprites)
frontend/public/assets/

# Temporary generation outputs (AI image/audio generation in progress)
ai-images-temp/
ai-audio-temp/
ai-image-backups/
tmp/codex-imagegen/
tmp/battle-map-polish/
scripts/ai-images/player-sprite-generation-record.json
*-temp/
*.tmp
.claude/

# AI image metadata is committed; generated binary results stay local.
ai-image-metadata/**
!ai-image-metadata/**/
!ai-image-metadata/**/*.json
!ai-image-metadata/fishing/sources/**/*.webp

# Battle-map model output remains local until an explicit promotion step.
# These later rules override the broad JSON metadata exception above so a
# candidate or review log cannot become tracked merely because it is JSON.
ai-image-metadata/battle-maps/candidates/**
ai-image-metadata/battle-maps/review/**
ai-image-metadata/battle-art/candidates/**

# Playwright test artifacts
playwright-report/
test-results/
