{
  "name": "@modia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modia Game Server API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:rollback": "node src/db/migrate.js rollback",
    "seed": "node src/db/seed.js",
    "world:migrate": "node src/scripts/world-migration.js",
    "battle:outbox:redrive": "node src/scripts/battle-terminal-outbox-redrive.js",
    "lint": "eslint src/",
    "test": "npm run test:all",
    "test:unit": "NODE_ENV=test node --test --test-concurrency=4 src/tests/unit/*.test.js src/tests/unit/**/*.test.js src/tests/balance/*.test.js",
    "test:unit:ai": "NODE_ENV=test node --test --test-concurrency=4 src/tests/unit/ai/*.test.js",
    "test:unit:worldgen": "NODE_ENV=test node --test --test-concurrency=4 src/tests/unit/worldgen/*.test.js",
    "test:worldgen:unit": "NODE_ENV=test node --test --test-concurrency=4 src/tests/unit/worldgen/*.test.js src/tests/unit/worldgenValidation.unit.test.js src/tests/unit/seed.unit.test.js src/tests/unit/worldSeedMetadata.unit.test.js src/tests/unit/worldgenIntegrityMigration.unit.test.js src/tests/unit/worldMigrationAuditMigration.unit.test.js src/tests/unit/worldMigrationMapping.unit.test.js src/tests/unit/worldMigration.unit.test.js src/tests/unit/worldMigrationScript.unit.test.js src/tests/unit/devSetupScript.unit.test.js src/tests/unit/ruins.unit.test.js src/tests/unit/traversalContract.unit.test.js src/tests/unit/battle/encounterService.unit.test.js src/tests/unit/db/caravanItems.unit.test.js",
    "test:worldgen:integration": "NODE_ENV=test node --test --test-concurrency=1 src/tests/integration/mapGeneration.integration.test.js src/tests/integration/battle.integration.test.js src/tests/integration/battleReconnection.integration.test.js src/tests/integration/nodeBlocking.integration.test.js src/tests/integration/ruins.integration.test.js",
    "test:worldgen:ci": "npm run test:worldgen:unit && npm run test:worldgen:integration",
    "worldgen:corpus": "node src/scripts/worldgen-corpus-report.js --start=1 --end=500",
    "worldgen:corpus:extended": "node src/scripts/worldgen-corpus-report.js --start=1 --end=5000",
    "test:worldgen:corpus": "npm run worldgen:corpus",
    "test:integration": "NODE_ENV=test node --test --test-concurrency=4 src/tests/integration/*.test.js",
    "test:ratelimit": "NODE_ENV=test TEST_RATE_LIMITS=true node --test --test-concurrency=4 src/tests/ratelimit/*.test.js",
    "test:quick": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:ratelimit",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:coverage": "c8 --include='src/**/*.js' --exclude='src/tests/**' --exclude='src/migrations/**' --exclude='src/scripts/**' --reporter=text --reporter=html npm run test:unit",
    "test:coverage:all": "c8 --include='src/**/*.js' --exclude='src/tests/**' --exclude='src/migrations/**' --exclude='src/scripts/**' --reporter=text --reporter=html npm run test:all"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "d3-delaunay": "^6.0.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
