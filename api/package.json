{
  "name": "@modia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modia Game Server API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:rollback": "node src/db/migrate.js rollback",
    "seed": "node src/db/seed.js",
    "lint": "eslint src/",
    "test": "npm run test:all",
    "test:unit": "NODE_ENV=test node --test src/tests/unit/*.test.js src/tests/balance/*.test.js",
    "test:integration": "NODE_ENV=test node --test src/tests/integration/*.test.js",
    "test:ratelimit": "NODE_ENV=test TEST_RATE_LIMITS=true node --test src/tests/ratelimit/*.test.js",
    "test:quick": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:ratelimit",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:coverage": "c8 --include='src/**/*.js' --exclude='src/tests/**' --exclude='src/migrations/**' --exclude='src/scripts/**' --reporter=text --reporter=html npm run test:unit",
    "test:coverage:all": "c8 --include='src/**/*.js' --exclude='src/tests/**' --exclude='src/migrations/**' --exclude='src/scripts/**' --reporter=text --reporter=html npm run test:all"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "d3-delaunay": "^6.0.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
