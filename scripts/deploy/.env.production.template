# =============================================================================
# Modia Production Environment Configuration
# =============================================================================
#
# Copy this file to <APP_DIR>/shared/.env and fill in the values.
#
# SECURITY: This file contains secrets. Never commit it to version control.
# Ensure proper permissions: chmod 600 <APP_DIR>/shared/.env
#
# To generate secure values:
#   JWT_SECRET:         openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 64
#   JWT_REFRESH_SECRET: openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 64
#   DB_PASSWORD:        openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 32
#   WORLD_SEED:         echo $((RANDOM * RANDOM))
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Trust proxy headers from nginx (required for rate limiting by IP)
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# Database (System PostgreSQL - not Docker)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modia_production
DB_USER=modia
# DB_PASSWORD=   # REQUIRED: Generate with: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 32

# Connection pool settings (optional, defaults shown)
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate unique secrets for production!
# Command: openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 64

# JWT_SECRET=    # REQUIRED: Generate with command above (64 chars)
JWT_EXPIRES_IN=15m

# JWT_REFRESH_SECRET=   # REQUIRED: Generate different value (64 chars)
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# World Generation
# -----------------------------------------------------------------------------
# Deterministic seed for procedural world generation.
# Same seed = same world layout. Change for a different world.
WORLD_SEED=REPLACE_WITH_NUMBER

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Frontend domain for cross-origin requests
CORS_ORIGIN=https://modia.mittonvillage.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Set to 'true' for detailed query logging (not recommended for production)
DEBUG=false

# Log level: error, warn, info, debug
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Default rate limiting window and max requests
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Audio Generation (Optional - for asset scripts only)
# -----------------------------------------------------------------------------
# Only needed if running audio generation scripts on the server
# Get API key from https://sunoapi.org
# SUNO_API_KEY=

# Webhook URL for Suno completion notifications
# SUNO_WEBHOOK_URL=

# Get API key from https://elevenlabs.io
# ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# AI Image Generation (Optional - for asset scripts only)
# -----------------------------------------------------------------------------
# Only needed if running image generation scripts on the server
# Get token from https://huggingface.co/settings/tokens
# HUGGINGFACE_API_TOKEN=

# Path to image-generator project
# IMAGE_GENERATOR_ROOT=

# -----------------------------------------------------------------------------
# Redis (Optional - for future scaling)
# -----------------------------------------------------------------------------
# If Redis is needed for session storage or caching
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=

# Datadog API key
# DD_API_KEY=
