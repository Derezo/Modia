# Server
NODE_ENV=development
PORT=3000

# Database (Docker Compose defaults for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modia
DB_USER=modia
DB_PASSWORD=modia_dev_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# World Generation
WORLD_SEED=12345

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
