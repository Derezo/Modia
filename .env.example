# Server
NODE_ENV=development
PORT=3000

# Logging
# Optional. Set to 'true' to enable detailed query logging and debug output
# (unset = off; NODE_ENV=development already enables the logger's debug level).
DEBUG=

# Database (Docker Compose defaults for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modia
DB_USER=modia
DB_PASSWORD=modia_dev_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# World Generation
# Strict signed 32-bit seed. Unset values use the same 123456 default.
WORLD_SEED=123456

# Smart setup never replaces an existing world on a contract mismatch unless
# all three destructive-reset acknowledgements are explicitly enabled.
# Optional; unset means false. Set each to 'true' only for a deliberate reset.
ALLOW_DESTRUCTIVE_WORLD_RESET=
WORLD_RESET_MAINTENANCE_WINDOW=
WORLD_RESET_BACKUP_VERIFIED=

# The live-world remapping command has a separate acknowledgement. It never
# authorizes the destructive bootstrap seed path. Optional; unset means false.
ALLOW_PLAYER_PRESERVING_WORLD_MIGRATION=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (optional - for distributed rate limiting)
# When set, rate limiting data is shared across server instances
# Format: redis://[[username][:password]@][host][:port][/db-number]
# REDIS_URL=redis://localhost:6379

# Audio Generation (for scripts/audio/ scripts)
# Get your Suno API key from https://sunoapi.org
SUNO_API_KEY=your_suno_api_key
# Optional: Webhook URL for Suno generation completion notifications
SUNO_WEBHOOK_URL=
# Get your ElevenLabs API key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# AI Image Generation (for scripts/ai-images/ scripts)
# Get your HuggingFace API token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here
# Path to image-generator project (optional, defaults to ~/Projects/image-generator/modia-generators)
IMAGE_GENERATOR_ROOT=
# Explicit Python executable path (optional, overrides conda detection)
# Use this if you're getting ENOENT errors when spawning Python
# AI_IMAGE_PYTHON=/home/user/miniconda3/bin/python3

# Dev/Test-Only Secrets (optional, safe defaults provided)
# These are ONLY used in non-production environments and have hardcoded fallbacks.
# Override them if you want custom values for your dev environment.
# TEST_BYPASS_SECRET=your-custom-test-bypass-secret
# ADMIN_WS_DEV_TOKEN=your-custom-admin-ws-token
