# Server
NODE_ENV=development
PORT=3000

# Logging
# Set to 'true' to enable detailed query logging and debug output
DEBUG=true

# Database (Docker Compose defaults for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modia
DB_USER=modia
DB_PASSWORD=modia_dev_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# World Generation
WORLD_SEED=123456

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (optional - for distributed rate limiting)
# When set, rate limiting data is shared across server instances
# Format: redis://[[username][:password]@][host][:port][/db-number]
# REDIS_URL=redis://localhost:6379

# Audio Generation (for scripts/audio/ scripts)
# Get your Suno API key from https://sunoapi.org
SUNO_API_KEY=your_suno_api_key
# Optional: Webhook URL for Suno generation completion notifications
SUNO_WEBHOOK_URL=https://your-webhook/suno
# Get your ElevenLabs API key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# AI Image Generation (for scripts/ai-images/ scripts)
# Get your HuggingFace API token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here
# Path to image-generator project (optional, defaults to ~/Projects/image-generator/modia-generators)
IMAGE_GENERATOR_ROOT=/path/to/image-generator/modia-generators
# Explicit Python executable path (optional, overrides conda detection)
# Use this if you're getting ENOENT errors when spawning Python
# AI_IMAGE_PYTHON=/home/user/miniconda3/bin/python3
