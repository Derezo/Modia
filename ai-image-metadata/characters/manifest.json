{
  "version": "1.1.0",
  "description": "Character sprite sheet metadata - animated 64x512 vertical strips (8 frames per animation)",
  "generationDefaults": {
    "mode": "flux",
    "sd15": {
      "controlnetWeight": 0.7,
      "ipadapterWeight": 0.7,
      "loraModel": "pixel-art-xl",
      "availableLoraModels": ["pixel-art-xl", "16-bit-pixel", "all-in-one-pixel", "retro-game-art", "cps2-pixel-art"]
    }
  },
  "weightPresets": {
    "balanced": {
      "controlnet": 0.7,
      "ipadapter": 0.7,
      "description": "Equal priority for pose accuracy and style consistency"
    },
    "maxConsistency": {
      "controlnet": 0.6,
      "ipadapter": 0.8,
      "description": "Maximum character consistency across frames"
    },
    "precisePoses": {
      "controlnet": 0.8,
      "ipadapter": 0.5,
      "description": "Accurate pose reproduction with more style variation"
    },
    "creative": {
      "controlnet": 0.4,
      "ipadapter": 0.4,
      "description": "More generation variation and artistic freedom"
    }
  },
  "qualityPresets": {
    "fast": {
      "steps": 15,
      "cfgScale": 7.0,
      "sampler": "euler",
      "scheduler": "normal",
      "description": "Quick testing - reduced steps"
    },
    "balanced": {
      "steps": 20,
      "cfgScale": 7.0,
      "sampler": "euler",
      "scheduler": "normal",
      "description": "Good balance of speed and quality"
    },
    "quality": {
      "steps": 32,
      "cfgScale": 8.0,
      "sampler": "euler_ancestral",
      "scheduler": "karras",
      "description": "Best quality - more steps"
    }
  },
  "poseTemplates": {
    "basePath": "poses/humanoid",
    "animations": ["idle", "walk", "attack", "hurt", "death", "cast", "victory"]
  },
  "spriteConvention": {
    "frameWidth": 64,
    "frameHeight": 64,
    "framesPerAnimation": 8,
    "sheetWidth": 64,
    "sheetHeight": 512,
    "layout": "vertical_strip"
  },
  "animations": {
    "idle": {
      "description": "Standing idle animation loop",
      "frameCount": 8,
      "frameDescriptions": [
        "standing neutral pose",
        "slight breathing motion inhale",
        "subtle weight shift left",
        "breathing exhale",
        "standing neutral pose",
        "slight breathing motion inhale",
        "subtle weight shift right",
        "breathing exhale"
      ]
    },
    "walk": {
      "description": "Walking movement cycle",
      "frameCount": 8,
      "frameDescriptions": [
        "walk cycle start left foot forward",
        "left foot plant mid stride",
        "passing position feet together",
        "right foot reaching forward",
        "right foot forward full stride",
        "right foot plant mid stride",
        "passing position feet together",
        "left foot reaching forward"
      ]
    },
    "attack": {
      "description": "Basic attack animation",
      "frameCount": 8,
      "frameDescriptions": [
        "attack windup stance",
        "pulling back weapon or fist",
        "maximum pullback ready to strike",
        "beginning forward swing",
        "mid swing motion blur",
        "attack impact extended",
        "follow through momentum",
        "returning to neutral"
      ]
    },
    "hurt": {
      "description": "Taking damage reaction",
      "frameCount": 8,
      "frameDescriptions": [
        "initial impact flinch",
        "recoiling backward",
        "maximum stagger pose",
        "beginning recovery",
        "stumbling forward",
        "regaining balance",
        "almost recovered",
        "back to ready stance"
      ]
    },
    "death": {
      "description": "Death/defeat animation",
      "frameCount": 8,
      "frameDescriptions": [
        "fatal hit reaction",
        "losing balance",
        "beginning to fall",
        "mid fall diagonal",
        "hitting ground",
        "bouncing slightly",
        "settling on ground",
        "final rest position"
      ]
    },
    "cast": {
      "description": "Spell casting animation (for magic users)",
      "frameCount": 8,
      "frameDescriptions": [
        "preparing to cast stance",
        "gathering magical energy",
        "hands glowing with power",
        "maximum energy buildup",
        "beginning to release",
        "spell release burst",
        "magical discharge",
        "returning to neutral"
      ]
    },
    "victory": {
      "description": "Victory/celebration animation",
      "frameCount": 8,
      "frameDescriptions": [
        "initial victory pose",
        "raising arms up",
        "arms fully raised",
        "pumping fist",
        "celebration gesture",
        "turning to crowd",
        "final pose hold",
        "returning to neutral"
      ]
    }
  },
  "categories": ["players", "enemies"],
  "categoryFiles": {
    "players": "players.json",
    "enemies": {
      "forest": "enemies/forest.json",
      "cave": "enemies/cave.json",
      "mountain": "enemies/mountain.json",
      "bridge": "enemies/bridge.json",
      "castle": "enemies/castle.json"
    }
  },
  "enemyCounts": {
    "forest": 6,
    "cave": 6,
    "mountain": 8,
    "bridge": 7,
    "castle": 7
  },
  "totalEnemies": 34,
  "outputPaths": {
    "players": "/assets/characters/player/{class}/{class}_{animation}.png",
    "enemies": "/assets/characters/enemies/{biome}/{id}/{id}_{animation}.png"
  },
  "tempDirectory": "ai-images-temp/characters"
}
